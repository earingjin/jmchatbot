# LLM provider: "gemini", "anthropic", or "mock"
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Password gate for /admin/dashboard (MVP-level auth — see README)
ADMIN_PASSWORD=2026

# Set false in production to disable the demo FAQ fallback.
FAQ_FALLBACK_ENABLED=true

# Supabase 프로젝트: jm-counseling과 동일 프로젝트 공유 (ap-northeast-1)
SUPABASE_URL=https://1111.supabase.co

# ⚠️ service_role 키는 보안상 자동으로 가져올 수 없습니다.
# Supabase 대시보드 → Project Settings → API → service_role 에서 직접 복사하세요.
# 이 키는 RLS를 완전히 우회하므로 절대 커밋하지 말고, .env.local에만 두세요.
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키_붙여넣기

# 브라우저(로그인 화면)에서 쓰는 값 — anon 키는 RLS로 보호되므로 노출되어도 안전합니다.
NEXT_PUBLIC_SUPABASE_URL=https://1234.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_키_붙여넣기

# 국방교육담당자 부서 공용 계정의 초기 비밀번호.
# scripts/seed-auth-users.mjs 실행 시에만 사용되며, 앱 코드에서는 읽지 않습니다.
DEFENSE_DEPT_PASSWORD=

