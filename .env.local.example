# LLM provider: "gemini", "anthropic", or "mock"
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Password gate for /admin/dashboard (MVP-level auth — see README)
ADMIN_PASSWORD=change-me
